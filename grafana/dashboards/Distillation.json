          "targets": [
            {
              "datasource": { "type": "postgres", "uid": "P44368ADAD746BC27" },
              "format": "time_series",
              "interval": "5s",
              "rawQuery": true,
              "rawSql": "SELECT time_bucket('$__interval', time) AS \"time\",\n       last(raw_mv, time)::double precision AS value,\n       CASE sensor_id\n         WHEN 'ec-1' THEN 'EC raw_mv'\n         WHEN 'ec-temp' THEN 'EC-Temperatur / PT1000 raw_mv'\n       END AS metric\nFROM sensor_measurements\nWHERE sensor_id IN ('ec-1', 'ec-temp')\n  AND raw_mv IS NOT NULL\n  AND $__timeFilter(time)\nGROUP BY 1, sensor_id\nORDER BY 1;",
              "refId": "A"
            }
          ],
          "title": "Analog-Rohwerte",
          "type": "timeseries"
        },
        {
          "datasource": { "type": "postgres", "uid": "P44368ADAD746BC27" },
          "description": "Neuester gespeicherter Datensatz je Sensor, unabhängig vom Dashboard-Zeitfenster, damit auch ausgefallene bzw. alte Sensoren sichtbar bleiben.",
          "fieldConfig": {
            "defaults": {
