            },
            "overrides": [
              { "matcher": { "id": "byName", "options": "Zeitpunkt" }, "properties": [{ "id": "unit", "value": "dateTimeAsIso" }] },
              { "matcher": { "id": "byName", "options": "Alter" }, "properties": [{ "id": "unit", "value": "s" }] }
            ]
          },
          "gridPos": { "h": 10, "w": 10, "x": 14, "y": 30 },
          "id": 8,
          "options": {
            "cellHeight": "sm",
            "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
            "showHeader": true,
            "sortBy": [{ "desc": false, "displayName": "Sensor" }]
          },
          "targets": [
            {
              "datasource": { "type": "postgres", "uid": "P44368ADAD746BC27" },
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT sensor_id AS \"Sensor\",\n       value AS \"Wert\",\n       raw_value AS \"Rohwert\",\n       raw_mv AS \"Rohspannung (mV)\",\n       unit AS \"Einheit\",\n       quality AS \"Qualität\",\n       time AS \"Zeitpunkt\",\n       EXTRACT(EPOCH FROM (now() - time))::double precision AS \"Alter\"\nFROM (\n  SELECT DISTINCT ON (sensor_id)\n         sensor_id, value, raw_value, raw_mv, unit, quality, time\n  FROM sensor_measurements\n  WHERE sensor_id IN ('vapor-temp', 'cooler-temp', 'ec-1', 'ec-temp')\n  ORDER BY sensor_id, time DESC\n) AS latest\nORDER BY sensor_id;",
              "refId": "A"
            }
          ],
          "title": "Sensor-/Diagnosewerte",
          "type": "table"
