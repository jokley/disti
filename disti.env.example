# Copy to disti.env on each controller; updates never overwrite the local file.
DOCKER_POSTGRES_INIT_USERNAME=postgres
DOCKER_POSTGRES_INIT_PASSWORD=change-me
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
DOCKER_GRAFANA_INIT_USERNAME=admin
DOCKER_GRAFANA_INIT_PASSWORD=change-me
DOCKER_MQTT_INIT_USERNAME=disti
DOCKER_MQTT_INIT_PASSWORD=change-me
DISTI_HARDWARE_MODE=mock
DISTI_POLL_INTERVAL_SECONDS=2
DISTI_HARDWARE_HEALTH_PORT=8081
# replay mode only
DISTI_REPLAY_RUN_ID=
DISTI_REPLAY_SPEED=1
DISTI_REPLAY_PRESERVE_TIMING=true
# dev, qa, or main; set per device, never in a release branch.
DISTI_UPDATE_BRANCH=dev
DISTI_UPDATE_REMOTE=origin
DISTI_UPDATE_HEALTH_URL=http://localhost:5000/health
